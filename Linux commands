APT = package Manager 
sudo = Super user do

# list of all the application that need to be updated
sudo apt update 

# Upgrade all the application 
sudo apt upgrade

# how to search for htop packages
apt search htop

# install and remove packages
sudo apt install/remove/purge htop

# Search for all the installed packages
apt list --installed | grep htop

# Tree Command 
tree <path> -L <numberoflevels>
Ex : tree /etc -L 2

